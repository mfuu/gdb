---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import IconChevronLeft from '@/assets/icons/IconChevronLeft.svg';
import IconChevronRight from '@/assets/icons/IconChevronRight.svg';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import Tags from '@/components/Tags.astro';
import Datetime from '@/components/Datetime.astro';
import ShareLinks from '@/components/ShareLinks.astro';
import Comment from '@/components/Comment.astro';
import BackToTop from '@/components/BackToTop.astro';
import getPath from '@/utils/getPath';
import slugify from '@/utils/slugify';
import { getSortedPosts } from '@/utils/getPosts';
import siteConfig from '@/site.config';

export interface Props {
  post: CollectionEntry<'posts'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const postResult = posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));

  return postResult;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  discussionNumber,
} = post.data;

const layoutProps = {
  title: `${title} | ${siteConfig.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  scrollSmooth: true,
  discussionNumber,
};

const slugifiedTags = tags.map(tag => ({ tag: slugify(tag), tagName: tag }));

const { Content } = await render(post);

/* ========== Prev/Next Posts ========== */

const posts = await getCollection('posts');
const sortedPosts = getSortedPosts(posts);
const allPosts = sortedPosts.map(({ data: { title }, id }) => ({
  id,
  title,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost = currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<DefaultLayout {...layoutProps}>
  <BackToTop title={title} pubDatetime={pubDatetime} modDatetime={modDatetime} />

  <div data-pagefind-body>
    <h1
      transition:name={slugify(title)}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} size="lg" />
    </div>

    <article
      id="article"
      class="app-prose max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) mt-8 w-full"
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <Tags tags={slugifiedTags} class="mt-4 mb-8" />

    <ShareLinks />

    <hr class="my-6 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a href={getPath(`/posts/${prevPost.id}`)} class="flex w-full gap-1 hover:opacity-75">
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>Previous Post</span>
              <div class="text-accent/85 text-sm">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(`/posts/${nextPost.id}`)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Post</span>
              <div class="text-accent/85 text-sm">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>

    <Comment discussionNumber={post.data.discussionNumber} class="mt-6" />
  </div>
</DefaultLayout>

<script is:inline data-astro-rerun>
  function createProgressBar() {
    const progressContainer = document.createElement('div');
    progressContainer.className = 'progress-container fixed top-0 z-10 h-1 w-full bg-background';

    const progressBar = document.createElement('div');
    progressBar.className = 'progress-bar h-1 w-0 bg-accent';
    progressBar.id = 'myBar';

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  function updateScrollProgress() {
    document.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById('myBar');
        if (myBar) {
          myBar.style.width = scrolled + '%';
        }
      }
    });
  }
  updateScrollProgress();

  function addHeadingLinks() {
    const headings = Array.from(document.querySelectorAll('h2, h3, h4, h5, h6'));
    for (const heading of headings) {
      heading.classList.add('group');
      const link = document.createElement('a');
      link.className =
        'heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100';
      link.href = '#' + heading.id;

      const span = document.createElement('span');
      span.ariaHidden = 'true';
      span.innerText = '#';
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  function attachCopyButtons() {
    const copyButtonLabel = 'Copy';
    const codeBlocks = Array.from(document.querySelectorAll('pre'));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement('div');
      wrapper.style.position = 'relative';

      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset = computedStyle.getPropertyValue('--file-name-offset').trim() !== '';

      const topClass = hasFileNameOffset ? 'top-(--file-name-offset)' : '-top-3';

      const copyButton = document.createElement('button');
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute('tabindex', '0');
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener('click', async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector('code');
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? '');

      button.innerText = 'Copied';

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  document.addEventListener('astro:after-swap', () =>
    window.scrollTo({ left: 0, top: 0, behavior: 'instant' })
  );
</script>
