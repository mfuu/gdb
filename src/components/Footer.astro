---
import type { HTMLAttributes } from 'astro/types';
import IconRss from '@/assets/icons/IconRss.svg';
import getPath from '@/utils/getPath';
import SocialLinks from './SocialLinks.astro';
import LinkButton from './LinkButton.astro';

type Props = {} & HTMLAttributes<'footer'>;

const { class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class:list={['app-layout mt-auto', className]} {...attrs}>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <div class="flex items-center gap-2">
      <SocialLinks />

      <LinkButton
        href={getPath('rss.xml')}
        class="focus-outline hover:text-accent p-1 transition-colors"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss class="size-5 stroke-current" />
      </LinkButton>
    </div>

    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
  </div>
</footer>
