---
import dayjs from 'dayjs';
import utc from 'dayjs/plugin/utc';
import timezone from 'dayjs/plugin/timezone';
import IconCalendar from '@/assets/icons/IconCalendar.svg';
import siteConfig from '@/site.config';

dayjs.extend(utc);
dayjs.extend(timezone);

export interface Props {
  class?: string;
  size?: 'xs' | 'sm' | 'lg';
  pubDatetime: string | Date;
  modDatetime: string | Date | undefined;
}

const { pubDatetime, modDatetime, size = 'sm', class: className = '' } = Astro.props;

/* ========== Formatted Datetime ========== */
const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(siteConfig.timezone);

const date = datetime.format(siteConfig.dateFormat);
const dateDetail = datetime.format(siteConfig.dateDetailFormat);
---

<div class:list={['text-muted-foreground flex items-center gap-x-2', className]} title={dateDetail}>
  <IconCalendar class:list={['inline-block size-5', { 'scale-90': size === 'sm' }]} />
  {isModified && <span class:list={['text-sm', { 'sm:text-base': size === 'lg' }]}>Updated:</span>}
  <time class:list={['text-sm', { 'sm:text-base': size === 'lg' }]}>{date}</time>
</div>
