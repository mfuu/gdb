---
import { render, type CollectionEntry } from 'astro:content';
import IconPinned from '@/assets/icons/IconPinned.svg';
import Datetime from './Datetime.astro';
import Excerpt from './Excerpt.astro';
import Tags from './Tags.astro';
import getPath from '@/utils/getPath';
import slugify from '@/utils/slugify';

type Props = {
  variant?: 'h2' | 'h3';
  excerpt?: boolean;
} & CollectionEntry<'posts'>;

const { variant: Heading = 'h2', id, data, excerpt = true } = Astro.props;

const { title, tags, pinned, pubDatetime, modDatetime } = data;

const slugifiedTags = tags.map(tag => ({ tag: slugify(tag), tagName: tag }));

const { Content } = await render(Astro.props);
---

<li class="my-6">
  <a
    href={getPath(`/posts/${id}`)}
    class:list={[
      'text-accent inline-block text-lg font-medium',
      'decoration-dashed underline-offset-4 hover:underline',
      'focus-visible:no-underline focus-visible:underline-offset-0',
    ]}
  >
    <Heading transition:name={slugify(title)}>
      {title}
    </Heading>
  </a>

  {
    excerpt && (
      <Excerpt>
        <Content />
      </Excerpt>
    )
  }

  <div class="flex gap-4">
    <Datetime {pubDatetime} {modDatetime} />

    <Tags tags={slugifiedTags} size="sm" class="opacity-80" />

    {pinned && <IconPinned class="ml-auto w-4 opacity-80" />}
  </div>
</li>
